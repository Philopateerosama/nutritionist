rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'philopateerosama2004@gmail.com' ||
        request.auth.token.email == 'philopateerosama1926@gmail.com'
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        isBootstrappedAdmin()
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isBootstrappedAdmin() || isAdmin();
    }

    // Recipes Collection (Read for authenticated users, managed by Admin)
    match /recipes/{recipeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Articles Collection (Read for authenticated users, managed by Admin)
    match /articles/{articleId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Reviews Collection (Read for authenticated users, managed by Admin)
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Chats Consultation Collection
    match /chats/{chatId} {
      allow get: if isSignedIn() && (chatId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (chatId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (chatId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();

      // Messages Subcollection
      match /messages/{messageId} {
        allow read: if isSignedIn() && (chatId == request.auth.uid || isAdmin());
        allow create: if isSignedIn() && (chatId == request.auth.uid || isAdmin()) && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    // User Progress Reports
    match /reports/{reportId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
